    "boss": false,
    "allow_flee": true,
    "recommend_level": 5,
    "interludes": [
      {
        "round": 1,
        "speaker": "苏言",
        "portrait": "suyan_serious",
        "text": "主教在念祷言——那会让你们说不出招式。被它点名的人，先退后防御，让没被封住的人打。"
      },
      {
        "round": 3,
        "speaker": "栖霞",
        "portrait": "qixia_normal",
        "text": "我拆过它的祷文：封住的只是「招式」，不是「拳头」。普攻也能把它敲到闭嘴。"
      }
    ],
    "victory": "btl_b5_result",
    "exp_reward": 45,
    "bg": "assets/placeholder/backgrounds/bg_throne_1.png"
  },
