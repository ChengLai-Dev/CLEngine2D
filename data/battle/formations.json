  "b3": {
    "id": "b3",
    "name": "明雷 · 锈铁傀儡 + 蚀页魔×2",
    "enemies": [
      { "enemy_id": "rust_golem", "count": 1 },
      { "enemy_id": "erosion_moth", "count": 2 }
    ],
    "boss": false,
    "allow_flee": true,
    "recommend_level": 3,
    "interludes": [
      {
        "round": 1,
        "speaker": "苏言",
        "portrait": "suyan_normal",
        "text": "看中间那只——锈铁傀儡。它是整座城的记忆铸成的壳，防御厚得咬不动。先别管它，把两边会咬人的字先清掉。"
      },
      {
        "round": 3,
        "speaker": "烬",
        "portrait": "jin_serious",
        "text": "壳再厚，也有缝。破防的斩击留着，等它立起铁壁再劈——一刀下去，它就知道什么叫疼。"
      }
    ],
    "victory": "btl_b3_result",
    "exp_reward": 40,
    "bg": "assets/placeholder/backgrounds/bg_city_1.png"
  },
  "b4": {
    "id": "b4",
    "name": "强制 · 锈铁战团长",
    "enemies": [
      { "enemy_id": "rust_commander", "count": 1 }
    ],
    "boss": false,
    "allow_flee": false,
    "recommend_level": 4,
    "interludes": [
      {
        "round": 1,
        "speaker": "栖霞",
        "portrait": "qixia_normal",
        "text": "小心！那身铁甲是活的——它会像守军一样列阵、加防。趁它还没来得及把城铸进甲里，先废掉它的刀。"
      },
      {
        "round": 2,
        "speaker": "烬",
        "portrait": "jin_serious",
        "text": "铁壁一立，就换裂甲斩。甲碎了，人也就跟着碎了。"
      },
      {
        "round": 4,
        "speaker": "苏言",
        "portrait": "suyan_smile",
        "text": "撑住。这座城守了三十天——今天轮到我们替它守完最后三回合。"
      }
    ],
    "victory": "btl_b4_result",
    "exp_reward": 80,
    "bg": "assets/placeholder/backgrounds/bg_city_1.png"
  },
  "b5": {
